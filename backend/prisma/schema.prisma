generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid()) @db.Char(36)
  name           String             @db.VarChar(191)
  email          String             @unique @db.VarChar(191)
  passwordHash   String             @map("password_hash") @db.VarChar(255)
  status         String             @default("active") @db.VarChar(32)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  sessions       UserSession[]
  authHandoffs   AuthHandoff[]
  providerConfigs ProviderConfig[]
  oauthStates    OauthState[]
  connectedAccounts ConnectedAccount[]
  s3StorageConfigs S3StorageConfig[]
  files          File[]
  fileShares     FileShare[]
  filePreviewTokens FilePreviewToken[]
  folders        Folder[]
  uploadSessions UploadSession[]
  auditLogs      AuditLog[]
  workspaceInvitesSent WorkspaceInvite[] @relation("WorkspaceInvitesSent")
  uploadRoutingPolicy UploadRoutingPolicy?
  apiKeys       ApiKey[]
  replicationPolicy ReplicationPolicy?
  deliveryRooms DeliveryRoom[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  name       String    @db.VarChar(191)
  keyPrefix  String    @map("key_prefix") @db.VarChar(32)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255)
  scopes     Json
  status     String    @default("active") @db.VarChar(32)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("api_keys")
}

model UploadRoutingPolicy {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @unique @map("user_id") @db.Char(36)
  mode               String   @default("most_available") @db.VarChar(32)
  priorityAccountIds Json     @map("priority_account_ids")
  roundRobinCursor   Int      @default(0) @map("round_robin_cursor")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upload_routing_policies")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model AuthHandoff {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_handoffs")
}

model ProviderConfig {
  id                    String             @id @default(uuid()) @db.Char(36)
  userId                String?            @map("user_id") @db.Char(36)
  provider              String             @db.VarChar(32)
  clientIdEncrypted     String             @map("client_id_encrypted") @db.Text
  clientSecretEncrypted String             @map("client_secret_encrypted") @db.Text
  redirectUri           String             @map("redirect_uri") @db.Text
  scopes                Json
  status                String             @default("active") @db.VarChar(32)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  oauthStates           OauthState[]
  connectedAccounts     ConnectedAccount[]

  @@index([userId])
  @@index([provider])
  @@map("provider_configs")
}

model OauthState {
  id               String         @id @default(uuid()) @db.Char(36)
  userId           String?        @map("user_id") @db.Char(36)
  providerConfigId String         @map("provider_config_id") @db.Char(36)
  flow             String         @default("connect") @db.VarChar(32)
  stateHash        String         @unique @map("state_hash") @db.VarChar(255)
  expiresAt        DateTime       @map("expires_at")
  usedAt           DateTime?      @map("used_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_states")
}

model ConnectedAccount {
  id                    String          @id @default(uuid()) @db.Char(36)
  userId                String          @map("user_id") @db.Char(36)
  providerConfigId      String?         @map("provider_config_id") @db.Char(36)
  provider              String          @db.VarChar(32)
  providerAccountId     String          @map("provider_account_id") @db.VarChar(191)
  email                 String          @db.VarChar(191)
  displayName           String?         @map("display_name") @db.VarChar(191)
  avatarUrl             String?         @map("avatar_url") @db.Text
  accessTokenEncrypted  String?         @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?         @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime?       @map("token_expires_at")
  scopes                Json
  status                String          @default("connected") @db.VarChar(32)
  lastError             String?         @map("last_error") @db.Text
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig        ProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  storageAccount        StorageAccount?
  files                 File[]
  replicas              FileReplica[]
  folders               Folder[]
  uploadSessions        UploadSession[]
  providerHealth        ProviderHealth?
  s3StorageConfig       S3StorageConfig?

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("connected_accounts")
}

model S3StorageConfig {
  id                       String           @id @default(uuid()) @db.Char(36)
  userId                   String           @map("user_id") @db.Char(36)
  connectedAccountId       String           @unique @map("connected_account_id") @db.Char(36)
  name                     String           @db.VarChar(191)
  bucket                   String           @db.VarChar(191)
  region                   String           @db.VarChar(191)
  endpoint                 String?          @db.Text
  accessKeyIdEncrypted     String           @map("access_key_id_encrypted") @db.Text
  secretAccessKeyEncrypted String           @map("secret_access_key_encrypted") @db.Text
  forcePathStyle           Boolean          @default(false) @map("force_path_style")
  prefix                   String           @default("9drive") @db.VarChar(191)
  quotaBytes               BigInt?          @map("quota_bytes")
  status                   String           @default("active") @db.VarChar(32)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount         ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("s3_storage_configs")
}

model StorageAccount {
  id                 String           @id @default(uuid()) @db.Char(36)
  connectedAccountId String           @unique @map("connected_account_id") @db.Char(36)
  totalBytes         BigInt?          @map("total_bytes")
  usedBytes          BigInt           @default(0) @map("used_bytes")
  availableBytes     BigInt?          @map("available_bytes")
  trashBytes         BigInt?          @map("trash_bytes")
  lastSyncedAt       DateTime?        @map("last_synced_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("storage_accounts")
}

model File {
  id                 String           @id @default(uuid()) @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  connectedAccountId String           @map("connected_account_id") @db.Char(36)
  folderId           String?          @map("folder_id") @db.Char(36)
  provider           String           @db.VarChar(32)
  providerFileId     String           @map("provider_file_id") @db.Text
  name               String           @db.VarChar(255)
  mimeType           String           @map("mime_type") @db.VarChar(191)
  sizeBytes          BigInt           @map("size_bytes")
  checksum           String?          @db.VarChar(191)
  status             String           @default("active") @db.VarChar(32)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  folder             Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares             FileShare[]
  previewTokens      FilePreviewToken[]
  replicationCopies  Int              @default(1) @map("replication_copies")
  replicationNextAt  DateTime?        @map("replication_next_at")
  replicationError   String?          @map("replication_error") @db.VarChar(255)
  replicationLockToken String?        @map("replication_lock_token") @db.Char(36)
  replicationLockUntil DateTime?      @map("replication_lock_until")
  replicas           FileReplica[]
  deliveryRoomId     String? @map("delivery_room_id") @db.Char(36)
  deliveryRoom       DeliveryRoom? @relation(fields: [deliveryRoomId], references: [id], onDelete: SetNull)

  @@index([deliveryRoomId, createdAt])
  @@index([status, replicationNextAt, replicationLockUntil])

  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([userId, status, folderId, createdAt])
  @@index([connectedAccountId])
  @@index([folderId])
  @@index([providerFileId(length: 191)])
  @@map("files")
}

model FileShare {
  id        String    @id @default(uuid()) @db.Char(36)
  fileId    String    @map("file_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  token     String?   @unique @db.VarChar(191)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  enabled   Boolean   @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@index([userId, enabled, createdAt])
  @@index([fileId, userId, enabled, createdAt])
  @@map("file_shares")
}

model FilePreviewToken {
  id        String   @id @default(uuid()) @db.Char(36)
  fileId    String   @map("file_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@map("file_preview_tokens")
}

model Folder {
  id                 String            @id @default(uuid()) @db.Char(36)
  userId             String            @map("user_id") @db.Char(36)
  parentId           String?           @map("parent_id") @db.Char(36)
  connectedAccountId String?           @map("connected_account_id") @db.Char(36)
  provider           String            @default("google_drive") @db.VarChar(32)
  providerFolderId   String?           @map("provider_folder_id") @db.VarChar(191)
  name               String            @db.VarChar(255)
  color              String            @default("text-blue-500") @db.VarChar(64)
  iconUrl            String?           @map("icon_url") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             Folder?           @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Folder[]          @relation("FolderChildren")
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  files              File[]
  uploadSessions     UploadSession[]    @relation("UploadSessionFolder")

  @@index([userId])
  @@index([userId, deletedAt, updatedAt])
  @@index([userId, deletedAt, parentId, updatedAt])
  @@index([parentId])
  @@index([connectedAccountId])
  @@map("folders")
}

model UploadSession {
  id                       String            @id @default(uuid()) @db.Char(36)
  userId                   String            @map("user_id") @db.Char(36)
  targetConnectedAccountId String?           @map("target_connected_account_id") @db.Char(36)
  folderId                 String?           @map("folder_id") @db.Char(36)
  fileName                 String            @map("file_name") @db.VarChar(255)
  mimeType                 String            @map("mime_type") @db.VarChar(191)
  sizeBytes                BigInt            @map("size_bytes")
  status                   String            @db.VarChar(32)
  generation               Int               @default(0)
  originalAccountId        String?           @map("original_account_id") @db.Char(36)
  lastFailureCode          String?           @map("last_failure_code") @db.VarChar(64)
  attempts                 UploadAttempt[]
  dropboxSessionId         String? @map("dropbox_session_id") @db.Text
  dropboxPath              String? @map("dropbox_path") @db.Text
  dropboxOffset            BigInt @default(0) @map("dropbox_offset")
  googleSessionUri         String?           @map("google_session_uri") @db.Text
  s3UploadId               String?           @map("s3_upload_id") @db.Text
  s3ObjectKey              String?           @map("s3_object_key") @db.Text
  chunkSizeBytes           Int               @default(5242880) @map("chunk_size_bytes")
  expiresAt                DateTime?         @map("expires_at")
  lockToken                String?           @map("lock_token") @db.Char(36)
  lockExpiresAt            DateTime?         @map("lock_expires_at")
  errorMessage             String?           @map("error_message") @db.Text
  createdAt                DateTime          @default(now()) @map("created_at")
  completedAt              DateTime?         @map("completed_at")
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetConnectedAccount   ConnectedAccount? @relation(fields: [targetConnectedAccountId], references: [id], onDelete: SetNull)
  folder                   Folder?           @relation("UploadSessionFolder", fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@index([status, expiresAt])
  @@map("upload_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(191)
  entityType String   @map("entity_type") @db.VarChar(191)
  entityId   String?  @map("entity_id") @db.Char(36)
  category String @default("activity") @db.VarChar(32)
  provider String? @db.VarChar(32)
  accountId String? @map("account_id") @db.Char(36)
  sourceAccountId String? @map("source_account_id") @db.Char(36)
  destinationAccountId String? @map("destination_account_id") @db.Char(36)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt, id])
  @@index([userId, action, createdAt, id])
  @@index([userId, category, createdAt, id])
  @@index([userId, provider, createdAt, id])
  @@index([userId, accountId, createdAt, id])
  @@index([userId, sourceAccountId, createdAt, id])
  @@index([userId, destinationAccountId, createdAt, id])
  @@map("audit_logs")
}

model WorkspaceInvite {
  id           String    @id @default(uuid()) @db.Char(36)
  inviterId    String    @map("inviter_id") @db.Char(36)
  inviteeEmail String    @map("invitee_email") @db.VarChar(191)
  targetType   String    @default("file") @map("target_type") @db.VarChar(32)
  targetId     String    @default("") @map("target_id") @db.Char(36)
  role         String    @default("viewer") @db.VarChar(32)
  status       String    @default("pending") @db.VarChar(32)
  revokedAt    DateTime? @map("revoked_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  inviter      User      @relation("WorkspaceInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeEmail, targetType, targetId], map: "workspace_invites_target_unique")
  @@index([inviteeEmail])
  @@index([targetType, targetId])
  @@map("workspace_invites")
}

model ProviderHealth {
  id                   String           @id @default(uuid()) @db.Char(36)
  connectedAccountId   String           @unique @map("connected_account_id") @db.Char(36)
  status               String           @default("UNKNOWN") @db.VarChar(32)
  latencyMs            Int?             @map("latency_ms")
  lastCheckedAt        DateTime?        @map("last_checked_at")
  lastSuccessAt        DateTime?        @map("last_success_at")
  consecutiveFailures  Int              @default(0) @map("consecutive_failures")
  lastErrorCode        String?          @map("last_error_code") @db.VarChar(64)
  lastErrorMessage     String?          @map("last_error_message") @db.VarChar(255)
  nextCheckAt          DateTime         @default(now()) @map("next_check_at")
  checkLeaseToken      String?          @map("check_lease_token") @db.Char(36)
  checkLeaseUntil      DateTime?        @map("check_lease_until")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  connectedAccount     ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([nextCheckAt, checkLeaseUntil])
  @@map("provider_health")
}

model UploadAttempt {
  id                 String        @id @default(uuid()) @db.Char(36)
  sessionId          String        @map("session_id") @db.Char(36)
  generation         Int
  accountId          String        @map("account_id") @db.Char(36)
  provider           String        @db.VarChar(32)
  s3UploadId         String?       @map("s3_upload_id") @db.Text
  s3ObjectKey        String?       @map("s3_object_key") @db.Text
  dropboxPath        String? @map("dropbox_path") @db.Text
  googleSessionUri   String?       @map("google_session_uri") @db.Text
  failureRecorded    Boolean       @default(false) @map("failure_recorded")
  cleanupPending     Boolean       @default(false) @map("cleanup_pending")
  nextCleanupAt      DateTime      @default(now()) @map("next_cleanup_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  session            UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, generation])
  @@index([sessionId, accountId])
  @@index([cleanupPending, nextCleanupAt])
  @@map("upload_attempts")
}

model ReplicationPolicy {
  userId    String   @id @map("user_id") @db.Char(36)
  copies    Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("replication_policies")
}

model FileReplica {
  id                 String   @id @default(uuid()) @db.Char(36)
  fileId             String   @map("file_id") @db.Char(36)
  connectedAccountId String   @map("connected_account_id") @db.Char(36)
  provider           String   @db.VarChar(32)
  providerFileId     String?  @map("provider_file_id") @db.Text
  s3UploadId         String?  @map("s3_upload_id") @db.Text
  isPrimary          Boolean  @default(false) @map("is_primary")
  status             String   @default("PENDING") @db.VarChar(32)
  sizeBytes          BigInt   @map("size_bytes")
  quotaAccounted     Boolean  @default(false) @map("quota_accounted")
  attempts           Int      @default(0)
  lastError          String?  @map("last_error") @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  file               File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  @@unique([fileId, connectedAccountId])
  @@index([connectedAccountId, status, quotaAccounted])
  @@map("file_replicas")
}

model DeliveryRoom {
  id String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  name String @db.VarChar(191)
  tokenHash String @unique @map("token_hash") @db.Char(64)
  tokenEncrypted String @map("token_encrypted") @db.Text
  passwordHash String? @map("password_hash") @db.VarChar(255)
  status String @default("active") @db.VarChar(32)
  expiresAt DateTime @map("expires_at")
  maxFiles Int @map("max_files")
  maxBytes BigInt @map("max_bytes")
  uploadedFiles Int @default(0) @map("uploaded_files")
  uploadedBytes BigInt @default(0) @map("uploaded_bytes")
  authWindowAt DateTime @default(now()) @map("auth_window_at")
  authAttempts Int @default(0) @map("auth_attempts")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  files File[]
  uploads DeliveryUpload[]
  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@map("delivery_rooms")
}

model DeliveryUpload {
  id String @id @default(uuid()) @db.Char(36)
  roomId String @map("room_id") @db.Char(36)
  requestKey String @map("request_key") @db.Char(36)
  providerFileId String? @map("provider_file_id") @db.Text
  cleanupNextAt DateTime @default(now()) @map("cleanup_next_at")
  name String @db.VarChar(255)
  mimeType String @map("mime_type") @db.VarChar(191)
  sizeBytes BigInt @map("size_bytes")
  status String @default("uploading") @db.VarChar(32)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  room DeliveryRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@unique([roomId, requestKey])
  @@index([roomId, status, expiresAt])
  @@index([status, cleanupNextAt])
  @@map("delivery_uploads")
}
