# Copy to backend/.env, then set your actual database credentials and secrets.
DATABASE_URL=mysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/9drive
APP_PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
# Preserve the existing value when reusing an existing database.
TOKEN_ENCRYPTION_KEY=replace-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_BYTES=5368709120
PROVIDER_HEALTH_ENABLED=true
PROVIDER_HEALTH_INTERVAL_SECONDS=300
PROVIDER_HEALTH_TIMEOUT_MS=8000
PROVIDER_HEALTH_FAILURE_THRESHOLD=3
PROVIDER_HEALTH_SLOW_MS=2000
# Optional Google OAuth setup; S3-only use does not need these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=

# Optional Dropbox app configuration (backend only)
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:4000/connected-accounts/dropbox/callback
